// Secret, Key Vault role assignments and identity outputs for the foundation. Kept in its own template so the vault
// and identity are referenced as `existing` here while foundation-resources.bicep creates them; ARM rejects a create
// and an existing declaration of the same resource in one template.
param vaultName string = ''
param secretName string = 'sessionhost-admin'
@secure()
param adminPassword string = ''
param deploymentIdentityName string = ''
param operatorObjectId string = ''
@allowed(['User', 'ServicePrincipal'])
param operatorPrincipalType string = 'User'

var useVault = !empty(vaultName)
var useIdentity = !empty(deploymentIdentityName)
var keyVaultSecretsUserRole = subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')

resource vault 'Microsoft.KeyVault/vaults@2023-07-01' existing = if (useVault) {
  name: useVault ? vaultName : 'unused'
}

resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' existing = if (useIdentity) {
  name: useIdentity ? deploymentIdentityName : 'unused'
}

resource adminSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = if (useVault && !empty(adminPassword)) {
  parent: vault
  name: secretName
  properties: {
    value: adminPassword
    contentType: 'AVD session host local administrator password (generated by avd.ps1)'
  }
}

resource identitySecretsUser 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (useVault && useIdentity) {
  name: guid(vault.id, deploymentIdentityName, keyVaultSecretsUserRole)
  scope: vault
  properties: {
    principalId: identity!.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: keyVaultSecretsUserRole
  }
}

resource operatorSecretsUser 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (useVault && !empty(operatorObjectId)) {
  name: guid(vault.id, operatorObjectId, keyVaultSecretsUserRole)
  scope: vault
  properties: {
    principalId: operatorObjectId
    principalType: operatorPrincipalType
    roleDefinitionId: keyVaultSecretsUserRole
  }
}

output keyVaultUri string = useVault ? vault!.properties.vaultUri : ''
output deploymentIdentityClientId string = useIdentity ? identity!.properties.clientId : ''
output deploymentIdentityPrincipalId string = useIdentity ? identity!.properties.principalId : ''
